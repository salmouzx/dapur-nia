rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Koleksi menu
    // Invariant 1: harga dan sisa_porsi tidak pernah bernilai negatif
    match /menu/{menuId} {
      allow read: if true;
      allow create, update: if request.resource.data.harga is number
                            && request.resource.data.harga >= 0
                            && request.resource.data.sisa_porsi is number
                            && request.resource.data.sisa_porsi >= 0;
      allow delete: if true;
    }

    // Koleksi pelanggan (ID dokumen = nomor WhatsApp)
    match /pelanggan/{whatsapp} {
      allow read, write: if true;
    }

    // Koleksi pesanan
    // Invariant 2: jumlah_porsi minimal 1
    // Invariant 3: total selalu sama dengan harga_satuan * jumlah_porsi + ongkir
    match /pesanan/{pesananId} {
      allow read: if true;
      allow create, update: if request.resource.data.jumlah_porsi is number
                            && request.resource.data.jumlah_porsi >= 1
                            && request.resource.data.ongkir is number
                            && request.resource.data.ongkir >= 0
                            && request.resource.data.total == (request.resource.data.harga_satuan * request.resource.data.jumlah_porsi + request.resource.data.ongkir);
      allow delete: if true;
    }
  }
}
